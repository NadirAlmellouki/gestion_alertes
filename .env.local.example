# PostgreSQL
POSTGRES_DB=alertops
POSTGRES_USER=alertops
POSTGRES_PASSWORD=alertops
POSTGRES_PORT=5432

# Kafka
KAFKA_PORT=9092

# Kafka UI
KAFKA_UI_PORT=8081

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Adminer
ADMINER_PORT=8082

# Keycloak (local)
KEYCLOAK_PORT=8083
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://localhost:8083/realms/alertops

# Gemini API (Phase 3) — never commit real keys
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Dynatrace ingestion (Phase 2)
DYNATRACE_INGESTION_TOKEN=dev-ingestion-token
