# PostgreSQL
POSTGRES_DB=alertops
POSTGRES_USER=alertops
POSTGRES_PASSWORD=alertops
POSTGRES_PORT=5432

# Kafka
KAFKA_PORT=9092

# Kafka UI
KAFKA_UI_PORT=8081

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Adminer
ADMINER_PORT=8082

# Keycloak (local)
KEYCLOAK_PORT=8083
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://localhost:8083/realms/alertops

# Gemini API — never commit real keys
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Dynatrace ingestion
DYNATRACE_INGESTION_TOKEN=dev-ingestion-token

# VoIP local Asterisk / WebRTC
ASTERISK_HTTP_PORT=8088
ASTERISK_TLS_PORT=8089
ASTERISK_SIP_PORT=5060
ASTERISK_SIP_TCP_PORT=5060
VOIP_ENABLED=true
VOIP_PROVIDER=asterisk
VOIP_ARI_URL=http://localhost:8088
VOIP_ARI_USER=alertops
VOIP_ARI_PASSWORD=alertops
VOIP_WS_URL=ws://localhost:8088/ws
# WSS (certificat auto-signe): wss://localhost:8089/ws
VOIP_AUDIO_DIR=docker/asterisk/sounds

# ElevenLabs TTS — never commit a real key
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
